{
  "name": "perps-sdk-monorepo",
  "version": "0.2.0-alpha.0",
  "private": true,
  "description": "LI.FI Perps SDK monorepo",
  "homepage": "https://github.com/lifinance/perps-sdk",
  "bugs": {
    "url": "https://github.com/lifinance/perps-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lifinance/perps-sdk.git"
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24"
  },
  "license": "Apache-2.0",
  "author": "LI.FI <dev@li.fi>",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build",
    "clean": "pnpm -r --parallel --filter './packages/**' clean",
    "clean:modules": "find . -name \"node_modules\" -type d -prune -exec rm -rf {} +",
    "release": "pnpm release:version && pnpm build && pnpm standard-version -a -s",
    "release:alpha": "pnpm release:version --preid alpha && pnpm build && pnpm standard-version -a -s --prerelease alpha --skip.changelog",
    "release:beta": "pnpm release:version --preid beta && pnpm build && pnpm standard-version -a -s --prerelease beta --skip.changelog",
    "release:version": "lerna version --no-changelog --no-push --no-git-tag-version --no-private",
    "release:publish:build": "pnpm -r --filter './packages/**' build:prerelease",
    "release:publish": "pnpm release:publish:build && pnpm -r --filter './packages/**' publish --access public --no-git-checks --tag latest && pnpm release:clean",
    "release:publish:alpha": "pnpm release:publish:build && pnpm -r --filter './packages/**' publish --access public --no-git-checks --tag alpha && pnpm release:clean",
    "release:publish:beta": "pnpm release:publish:build && pnpm -r --filter './packages/**' publish --access public --no-git-checks --tag beta && pnpm release:clean",
    "release:clean": "pnpm -r --parallel --filter './packages/**' exec sh -c \"node ../../scripts/postrelease.js && rm -rf *.md\"",
    "check": "biome check",
    "check:write": "biome check --write",
    "check:write:unsafe": "biome check --write --unsafe",
    "check:types": "pnpm -r --parallel --filter './packages/**' check:types",
    "check:circular-deps": "pnpm -r --parallel --filter './packages/**' check:circular-deps",
    "test": "pnpm -r --parallel --filter './packages/**' test",
    "test:cov": "pnpm -r --parallel --filter './packages/**' test:cov",
    "test:unit": "pnpm -r --parallel --filter './packages/**' test:unit",
    "knip:check": "knip --dependencies --files --no-config-hints --exclude binaries",
    "knip:write": "pnpm knip:check --fix",
    "pre-commit": "pnpm check && pnpm check:types && pnpm check:circular-deps && pnpm knip:check",
    "pre-push": "pnpm test:unit",
    "prepare": "husky"
  },
  "standard-version": {
    "scripts": {
      "prerelease": "pnpm install && git add .",
      "postbump": "pnpm check:write && git add ."
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@types/node": "^25.2.3",
    "husky": "^9.1.7",
    "knip": "^5.82.1",
    "lerna": "^9.0.7",
    "standard-version": "^9.5.0",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
