{
  "name": "perps-sdk",
  "private": true,
  "description": "LI.FI Perps SDK monorepo",
  "homepage": "https://github.com/lifinance/perps-sdk",
  "bugs": {
    "url": "https://github.com/lifinance/perps-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lifinance/perps-sdk.git"
  },
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=24"
  },
  "license": "Apache-2.0",
  "author": "Aaron Boyd <aaron@li.finance>",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build",
    "clean": "pnpm -r --parallel --filter './packages/**' run clean",
    "clean:modules": "find . -name \"node_modules\" -type d -prune -exec rm -rf {} +",
    "changeset:version": "changeset version && pnpm install --lockfile-only && pnpm check:write",
    "changeset:prepublish": "pnpm build && pnpm -r --parallel --filter './packages/**' build:prerelease",
    "changeset:publish": "pnpm changeset:prepublish && pnpm --config.verify-deps-before-run=false changeset publish",
    "changeset:postpublish": "pnpm -r --parallel --filter './packages/**' exec node ../../scripts/postrelease.js",
    "check": "biome check",
    "check:write": "biome check --write",
    "check:write:unsafe": "biome check --write --unsafe",
    "check:types": "pnpm -r --parallel --filter './packages/**' check:types",
    "check:circular-deps": "pnpm -r --parallel --filter './packages/**' check:circular-deps",
    "test": "pnpm -r --parallel --filter './packages/**' test",
    "test:cov": "pnpm -r --parallel --filter './packages/**' test:cov",
    "test:unit": "pnpm -r --parallel --filter './packages/**' test:unit",
    "knip:check": "knip --dependencies --files --no-config-hints --exclude binaries",
    "knip:write": "pnpm knip:check --fix",
    "pre-commit": "pnpm check && pnpm check:types && pnpm check:circular-deps && pnpm knip:check",
    "pre-push": "pnpm test:unit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@types/node": "^25.2.3",
    "husky": "^9.1.7",
    "knip": "^5.82.1",
    "typescript": "^5.9.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
