{
  "name": "@lifi/perps-types",
  "version": "0.2.0-alpha.0",
  "description": "Shared types for the LI.FI perps stack",
  "keywords": [
    "lifi",
    "perps",
    "perpetuals",
    "types",
    "defi",
    "trading",
    "cross-chain"
  ],
  "homepage": "https://github.com/lifinance/perps-types",
  "bugs": {
    "url": "https://github.com/lifinance/perps-types"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/lifinance/perps-types.git"
  },
  "license": "Apache-2.0",
  "author": "LI.FI <github@li.finance>",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./src/_types/index.d.ts",
        "default": "./src/_esm/index.js"
      },
      "require": {
        "types": "./src/_types/index.d.ts",
        "default": "./src/_cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./src/_cjs/index.js",
  "module": "./src/_esm/index.js",
  "types": "./src/_types/index.d.ts",
  "typings": "./src/_types/index.d.ts",
  "sideEffects": false,
  "files": [
    "src",
    "!src/**/*.tsbuildinfo",
    "!src/**/*.unit.spec.ts"
  ],
  "scripts": {
    "build": "pnpm clean && pnpm build:cjs && pnpm build:esm && pnpm build:types",
    "build:cjs": "tsc --project ./tsconfig.build.json --module commonjs --outDir ./src/_cjs --removeComments --verbatimModuleSyntax false && printf '{\"type\":\"commonjs\"}' > ./src/_cjs/package.json",
    "build:esm": "tsc --project ./tsconfig.build.json --module es2015 --outDir ./src/_esm && printf '{\"type\": \"module\",\"sideEffects\":false}' > ./src/_esm/package.json",
    "build:types": "tsc --project ./tsconfig.build.json --module esnext --declarationDir ./src/_types --emitDeclarationOnly --declaration --declarationMap",
    "build:prerelease": "pnpm build && pnpm node scripts/prepublishOnly.js",
    "check:types": "tsc --noEmit",
    "check:circular-deps": "madge --circular $(find ./src -name '*.ts' -not -name '*.unit.spec.ts')",
    "clean": "rm -rf dist tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo src/tsconfig.build.tsbuildinfo src/_esm src/_cjs src/_types",
    "test": "vitest --run",
    "test:unit": "vitest --run .unit.spec.ts --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "viem": "2.48.8"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "fs-extra": "^11.2.0",
    "madge": "^8.0.0",
    "typescript": "^5.9.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
