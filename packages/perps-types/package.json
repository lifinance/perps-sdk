{
  "name": "@lifi/perps-types",
  "version": "1.9.0",
  "description": "Shared types for the LI.FI perps stack",
  "keywords": [
    "lifi",
    "perps",
    "perpetuals",
    "types",
    "defi",
    "trading",
    "cross-chain"
  ],
  "homepage": "https://github.com/lifinance/perps-sdk",
  "bugs": {
    "url": "https://github.com/lifinance/perps-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lifinance/perps-sdk.git"
  },
  "license": "Apache-2.0",
  "author": "Aaron Boyd <aaron@li.finance>",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "typings": "./dist/types/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**",
    "!dist/**/*.tsbuildinfo",
    "src/**/*.ts",
    "!src/**/*.spec.ts",
    "!src/**/*.test.ts",
    "!src/**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "pnpm clean && pnpm build:cjs && pnpm build:esm && pnpm build:types && pnpm build:clean",
    "build:cjs": "tsc --project ./tsconfig.json --module commonjs --outDir ./dist/cjs --removeComments --verbatimModuleSyntax false && mkdir -p ./dist/cjs && printf '{\"type\":\"commonjs\"}' > ./dist/cjs/package.json",
    "build:esm": "tsc --project ./tsconfig.json --module es2022 --outDir ./dist/esm && mkdir -p ./dist/esm && printf '{\"type\": \"module\",\"sideEffects\":false}' > ./dist/esm/package.json",
    "build:types": "tsc --project ./tsconfig.json --module esnext --declarationDir ./dist/types --emitDeclarationOnly --declaration --declarationMap",
    "build:clean": "rm -rf tsconfig.tsbuildinfo ./dist/tsconfig.tsbuildinfo",
    "build:prerelease": "pnpm node ../../scripts/prerelease.js",
    "clean": "pnpm build:clean && rm -rf dist",
    "check:types": "tsc --noEmit",
    "check:circular-deps": "madge --circular $(find ./src -name '*.ts' -not -name '*.unit.spec.ts')",
    "test": "vitest --run",
    "test:cov": "vitest --run --coverage",
    "test:unit": "vitest --run .unit.spec.ts --passWithNoTests"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.8",
    "madge": "^8.0.0",
    "typescript": "^5.9.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
