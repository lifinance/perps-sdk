{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "./src",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "paths": {}
  },
  "include": ["./src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "./src/**/*.spec.ts",
    "./src/**/*.mock.ts",
    "./src/**/*.handlers.ts"
  ]
}
