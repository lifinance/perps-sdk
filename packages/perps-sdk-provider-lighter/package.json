{
  "name": "@lifi/perps-sdk-provider-lighter",
  "version": "18.0.1",
  "description": "Lighter provider plugin for @lifi/perps-sdk",
  "homepage": "https://github.com/lifinance/perps-sdk",
  "bugs": {
    "url": "https://github.com/lifinance/perps-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lifinance/perps-sdk.git"
  },
  "license": "Apache-2.0",
  "author": "Aaron Boyd <aaron@li.finance>",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "typings": "./dist/types/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**",
    "!dist/**/*.tsbuildinfo",
    "src/**/*.ts",
    "!src/**/*.spec.ts",
    "!src/**/*.test.ts",
    "!src/**/*.mock.ts",
    "!src/**/*.handlers.ts",
    "!src/**/*.tsbuildinfo",
    "!**/__mocks__/**",
    "!*.tmp",
    "!*.env",
    "!tsconfig.json",
    "!tsconfig.build.json"
  ],
  "scripts": {
    "build": "pnpm clean && pnpm build:wasm-exec && pnpm build:cjs && pnpm build:esm && pnpm build:types && pnpm build:assets && pnpm build:verify && pnpm build:clean",
    "build:cjs": "tsc --project ./tsconfig.json --module commonjs --outDir ./dist/cjs --removeComments --verbatimModuleSyntax false && mkdir -p ./dist/cjs && printf '{\"type\":\"commonjs\"}' > ./dist/cjs/package.json",
    "build:esm": "tsc --project ./tsconfig.json --module es2022 --outDir ./dist/esm && mkdir -p ./dist/esm && printf '{\"type\": \"module\",\"sideEffects\":false}' > ./dist/esm/package.json",
    "build:assets": "mkdir -p ./dist/wasm && cp ./wasm/lighter-signer.wasm ./dist/wasm/ && cp ./src/signers/wasmBinaryUrl.js ./dist/esm/signers/wasmBinaryUrl.js && cp ./src/signers/wasmBinaryUrl.vite.js ./dist/esm/signers/wasmBinaryUrl.vite.js && cp ./src/signers/wasmBinaryUrl.cjs ./dist/cjs/signers/wasmBinaryUrl.js",
    "build:wasm-exec": "pnpm node ./scripts/generate-wasm-exec.mjs",
    "build:verify": "pnpm node ./scripts/verify-package-assets.mjs",
    "build:types": "tsc --project ./tsconfig.json --module esnext --declarationDir ./dist/types --emitDeclarationOnly --declaration --declarationMap",
    "build:clean": "rm -rf tsconfig.tsbuildinfo ./dist/tsconfig.tsbuildinfo",
    "build:prerelease": "pnpm node ../../scripts/prerelease.js",
    "clean": "pnpm build:clean && rm -rf dist",
    "check:types": "tsc --build ./tsconfig.build.json",
    "check:types:spec": "tsc --noEmit -p tsconfig.spec.json",
    "check:circular-deps": "madge --circular $(find ./src -name '*.ts' -not -name '*.unit.spec.ts')",
    "test": "vitest --run",
    "test:cov": "vitest --run --coverage",
    "test:unit": "vitest --run .unit.spec.ts --passWithNoTests",
    "test:consumers": "pnpm node --experimental-vm-modules ./scripts/verify-consumer-bundlers.mjs"
  },
  "dependencies": {
    "@lifi/perps-types": "workspace:^",
    "big.js": "^7.0.1",
    "viem": "^2.55.18"
  },
  "peerDependencies": {
    "@lifi/perps-sdk": "workspace:^"
  },
  "devDependencies": {
    "@lifi/perps-sdk": "workspace:^",
    "@types/big.js": "^7.0.0",
    "@vitest/coverage-v8": "^2.1.8",
    "madge": "^8.0.0",
    "typescript": "^5.9.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "perps",
    "perpetuals",
    "trading",
    "defi",
    "lifi",
    "sdk",
    "viem",
    "lighter"
  ]
}
